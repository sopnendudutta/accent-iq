generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String       @unique
  imageUrl          String?
  provider          AuthProvider @default(EMAIL)
  providerAccountId String?
  passwordHash      String?

  pronunciationHistory   PronunciationHistory[]
  pronunciationFavorites PronunciationFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

enum AuthProvider {
  GOOGLE
  META
  EMAIL
}

enum Accent {
  US
  UK
  AUSTRALIAN
  INDIAN
  CANADIAN
  IRISH
  NEW_ZEALAND
  SOUTH_AFRICAN
}

model PronunciationHistory {
  id String @id @default(cuid())

  inputType PronunciationInputType @default(TEXT)

  text   String
  accent Accent

  phonetic  String?
  syllables Json?
  tips      Json?
  result    Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PronunciationFavorite {
  id String @id @default(cuid())

  inputType PronunciationInputType @default(TEXT)

  text           String
  normalizedText String
  accent         Accent

  phonetic      String?
  ipa           String?
  syllables     Json?
  stressPattern String?

  mouthTip      String?
  commonMistake String?
  tips          Json?

  exampleSentence String?
  result          Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedText, accent])
  @@index([userId])
}

enum PronunciationInputType {
  TEXT
  VOICE
}
